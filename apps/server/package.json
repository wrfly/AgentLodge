{
  "name": "@agentlodge/server",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/core/db && cp src/core/db/schema.sql dist/core/db/",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:period": "tsx src/core/db/period.test.ts",
    "test:gate-pool": "tsx src/gateway/gate-pool.test.ts",
    "test:routing": "tsx src/gateway/routing.test.ts",
    "test:routes": "tsx src/gateway/routes.test.ts",
    "test:providers": "tsx src/core/db/providers.test.ts",
    "test:pricing": "tsx src/core/db/pricing.test.ts",
    "test:upstream": "tsx src/gateway/upstream.test.ts",
    "test:credential": "tsx src/core/credential.test.ts",
    "test:registry": "tsx src/app/agents/registry.test.ts",
    "test:i18n": "tsx src/core/i18n/i18n.test.ts",
    "test:workspace": "tsx src/app/workspace.test.ts",
    "test:quota-report": "tsx src/gateway/quota-report.test.ts",
    "test:cli-install": "tsx src/app/cli-install.test.ts",
    "test:upstream-allowance": "tsx src/gateway/upstream-allowance.test.ts",
    "test:models": "tsx src/gateway/models.test.ts",
    "test:protocol": "tsx src/core/protocol.test.ts",
    "test:model-refresh": "tsx src/gateway/model-refresh.test.ts",
    "test:quota": "tsx src/core/quota.test.ts",
    "test:memory": "tsx src/app/memory.test.ts",
    "test:profile": "tsx src/core/db/profile.test.ts",
    "test:recap": "tsx src/app/recap.test.ts",
    "reset-password": "tsx src/cli/reset-password.ts",
    "test:reset-password": "tsx src/cli/reset-password.test.ts",
    "test:containers": "tsx src/app/containers.test.ts",
    "test:mail": "tsx src/app/mail.test.ts",
    "test:schema": "tsx src/core/db/schema.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.1",
    "fastify": "^5.2.1",
    "jose": "^6.2.9",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
