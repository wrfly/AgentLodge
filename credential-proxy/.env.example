GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8795
# Shared secret callers present to this gateway. Comma-separated for several. Empty = no
# authentication, which is only allowed on a loopback address.
GATEWAY_TOKEN=
# The subscription allowance is shared, so concurrency is capped
GATEWAY_MAX_CONCURRENT=2

# DeepSeek: passed straight through, with the key living only here
DEEPSEEK_API_KEY=
DEEPSEEK_UPSTREAM=https://api.deepseek.com

# Anthropic / Codex: the host's subscription credentials are used, so no key goes here.
# They live in the auther sidecar (authkey-sync/ → `auther`), not in this process.
# This gateway talks to the auther over a Unix domain socket and receives only
# short-lived access tokens — it never sees a refresh token.
AUTHER_SOCKET=/run/agentlodge/auther.sock

# Metering
GATEWAY_METERING=true
GATEWAY_DATA_DIR=./data
