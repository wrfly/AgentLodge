# AgentLodge — deployment settings.
#
# Save as `.env` beside compose.release.yml. Everything marked required has no default
# worth guessing, and compose refuses to start rather than pick one for you.

# ── Required ──────────────────────────────────────────────────────────────────

# Fixed, and secret. Whoever holds it can forge an administrator and the billing
# credentials both, and changing it makes every key saved in the console permanently
# undecryptable — they would all have to be entered again.
#   openssl rand -base64 48
JWT_SECRET=

# Guards the audit proxy's control API. Leave it empty and the proxy does not mount that
# API at all, which makes the console's audit-proxy panel read-only — a deliberate default,
# since an endpoint that can edit the allowlist can aim the proxy anywhere.
#   openssl rand -base64 32
AUDIT_ADMIN_TOKEN=

# **An absolute path on the host.** Not a named volume, and not a relative path: app creates
# agent containers through the mounted socket, and their `-v` sources are resolved by the
# engine on the host. Create it as uid 10001 before the first start:
#   sudo install -d -o 10001 -g 10001 /srv/agentlodge/data
DATA_DIR=/srv/agentlodge/data

# The host's docker group gid, so app can reach the socket while running as uid 10001:
#   getent group docker | cut -d: -f3
DOCKER_GID=

# ── Where it is served ────────────────────────────────────────────────────────

# Your domain: Caddy obtains a certificate for it automatically. `localhost` serves plain
# http on localhost only.
SITE_ADDRESS=localhost

# The address people actually open. It also decides which origins may make credentialed
# cross-origin requests, so it has to match what is in the address bar.
APP_BASE_URL=https://your.domain

# What the settings page tells users to put in ANTHROPIC_BASE_URL. Defaults to APP_BASE_URL,
# which is right unless a reverse proxy puts the gateway on a different hostname.
#PUBLIC_GATEWAY_URL=

# Must be false when serving plain http, or the browser drops the session cookie and the
# login appears to succeed and then immediately not have.
SECURE_COOKIES=true

# Rootless podman cannot bind below 1024; on Docker the defaults are fine.
#HTTP_PORT=80
#HTTPS_PORT=443

# ── Images ────────────────────────────────────────────────────────────────────

# Which account's images to run. A fork publishes under its own owner, so this is how you
# run yours.
#AGENTLODGE_NAMESPACE=wrfly

# Which channel. `latest` is the newest release tag; `master` is the rolling build of the
# branch. Pin a version (`1.2.3`) if you would rather decide when to move.
#AGENTLODGE_TAG=latest

# The per-user agent container. Pulled by the engine on the host rather than by compose, so
# after changing this run: docker pull <that image>
#AGENT_IMAGE=docker.io/wrfly/agentlodge-agent:latest

# ── Optional ──────────────────────────────────────────────────────────────────

# Docker's socket. Point it at podman's if that is what the host runs.
#PODMAN_SOCK=/var/run/docker.sock

# Concurrent upstream requests the gateway allows
#MAX_UPSTREAM_CONCURRENCY=3

# Hosts the audit proxy may forward to. Empty means no restriction, which lets anything that
# can reach the proxy make it fetch any address at all.
#AUDIT_ALLOW_HOSTS=api.deepseek.com,api.anthropic.com

# How long audit data is kept. A compliance question rather than a technical one.
#AUDIT_MAX_DAYS=30
#AUDIT_MAX_COUNT=100000
#AUDIT_MAX_MB=10240

# Extra directories an upstream key may be read from, colon-separated like PATH. Empty uses
# <DATA_DIR>/secrets and /run/secrets. **app and gateway must agree**, which they do here
# since both read this one variable.
#SECRET_FILE_ROOTS=

# For the `authkey` profile: which directory holds .credentials.json
#CLAUDE_CREDENTIALS_DIR=/root/.claude

# The deployment's clock. Everything time-bucketed uses it: which day a usage row
# lands on, and where the quota windows fall. Leave it at UTC and a day boundary
# lands in the middle of the afternoon. Find yours with `cat /etc/timezone`.
TZ=UTC
